# ============================================
# APIPAY - Root .gitignore
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ============================================
# Build Output
# ============================================
dist/
build/
out/
.next/
*.tsbuildinfo

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ============================================
# Database
# ============================================
# PostgreSQL databases (development)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Prisma
prisma/migrations/migration_lock.toml
# Note: Keep migration files in version control

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# IDEs and Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Eclipse
.project
.classpath
.c9/
*.launch
.settings/

# ============================================
# Operating System
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
.tmp/
*.tmp

# ============================================
# Next.js Specific
# ============================================
.next/
.vercel
.turbo

# ============================================
# NestJS Specific
# ============================================
dist/
.cache/

# ============================================
# Package Manager Lock Files
# ============================================
# Keep package-lock.json (npm) in version control
# Ignore other package manager lock files
yarn.lock
pnpm-lock.yaml

# ============================================
# Docker
# ============================================
# Note: .dockerignore files are NOT ignored — they must be committed for Docker builds

# ============================================
# Misc
# ============================================
.cache
.parcel-cache
.eslintcache
.stylelintcache
*.tgz
.npm
.yarn-integrity
dashboard-example
integration-example
